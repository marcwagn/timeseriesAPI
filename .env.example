# Copy to .env at the project root before running docker compose.
# For local development, also copy to backend/src/.env and set TIMESCALE_DSN=localhost:5432/timeseries_db

APP_NAME=TimescaleAPIProject

# Application database credentials (DML only)
TIMESCALE_USER=app_user
TIMESCALE_PASSWORD=app_password
TIMESCALE_DSN=timescaledb:5432/timeseries_db

# Migration credentials (superuser, used only on startup)
MIGRATION_USER=postgres
MIGRATION_PASSWORD=postgres

# JWT generate with: openssl rand -hex 32
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO
